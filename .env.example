# ======================== MongoDB Database & Collections ========================
# MongoDB Atlas Connection URI with credentials
MONGODB_URI=""
# Database Name
DB_NAME="db_stories_tests"

# Test Cases Collection & Search Indexes
COLLECTION_NAME="test_cases"
VECTOR_INDEX_NAME="vector_index_test_cases"
BM25_INDEX_NAME="bm25_search"

# User Stories Collection & Search Indexes
USER_STORIES_COLLECTION_NAME="user_stories"
USER_STORIES_VECTOR_INDEX_NAME="vector_index_user_story"
USER_STORIES_BM25_INDEX_NAME="bm25_user_stories"

# ======================== Task-Specific LLM Models ========================
# 1. Primary Test Case Generation / QA LLM (groq | gemini | openai | claude | mistral)
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-1.5-flash"

# 2. Semantic Reranking LLM (groq | gemini | openai | claude | mistral)
RERANK_PROVIDER="groq"
RERANK_MODEL="qwen/qwen3.6-27b"

# 3. Summarization & Deduplication LLM (groq | gemini | openai | claude | mistral)
SUMMARIZATION_PROVIDER="groq"
SUMMARIZATION_MODEL="qwen/qwen3.6-27b"

# ======================== Token Optimization & 8k Budget Control ========================
# Enable token budgeting to strictly stay under 8,000 tokens for free-tier Groq/Gemini models
ENABLE_TOKEN_OPTIMIZATION="true"
MAX_TOTAL_TOKENS="8000"
MAX_GENERATION_TOKENS="4000"
MAX_SUMMARY_TOKENS="400"

# ======================== Automatic Fallback Mechanism ========================
# Enable automatic failover on rate limits (HTTP 429, 8k token caps) or server outages
ENABLE_FALLBACK="true"
FALLBACK_LLM_PROVIDER="mistral"
FALLBACK_LLM_MODEL="mistral-small-latest"

# ======================== Vector Embeddings Configuration ========================
# Supported Embedding Providers: mistral (1024 dims) | openai (1536 dims) | gemini (768 dims)
EMBEDDING_PROVIDER="mistral"
EMBEDDING_MODEL="mistral-embed"

# ======================== API Keys Vault ========================
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
MISTRAL_API_KEY=""

# ======================== Server & DeepEval LLM Evaluation Configuration ========================
PORT=3001
DEEPEVAL_PORT=8000
DEEPEVAL_URL="http://localhost:8000/eval"
EVAL_MODEL="openai/gpt-oss-120b"
ENABLED_METRICS="faithfulness,contextual_precision,contextual_recall,pii_leakage,bias,hallucination,ragas,answer_relevancy"
